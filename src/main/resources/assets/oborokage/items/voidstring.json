        "on_false": {
          "type": "minecraft:model",
          "model": "oborokage:item/voidstring_tachi"
        },
        "on_true": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:use_duration",
          "scale": 1,
          "entries": [
            {
              "threshold": 10,
              "model": {
                "type": "minecraft:model",
                "model": "oborokage:item/voidstring_charged4"
              }
            },
            {
              "threshold": 20,
              "model": {
                "type": "minecraft:model",
                "model": "oborokage:item/voidstring_charged8"
              }
            },
            {
              "threshold": 30,
              "model": {
                "type": "minecraft:model",
                "model": "oborokage:item/voidstring_charged12"
              }
            },
            {
              "threshold": 40,
              "model": {
                "type": "minecraft:model",
                "model": "oborokage:item/voidstring_charged15"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "oborokage:item/voidstring_sheathed"
          }
        }
      }
    }
