{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "ancient",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": "gui",
              "model": {
                "type": "minecraft:model",
                "model": "oborokage:item/ancient_voidstring_icon"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:condition",
            "property": "minecraft:using_item",
            "on_false": {
              "type": "minecraft:model",
              "model": "oborokage:item/ancient_voidstring_tachi"
            },
            "on_true": {
              "type": "minecraft:range_dispatch",
              "property": "minecraft:use_duration",
              "scale": 1,
              "entries": [
                {
                  "threshold": 10,
                  "model": {
                    "type": "minecraft:model",
                    "model": "oborokage:item/ancient_voidstring_charged4"
                  }
                },
                {
                  "threshold": 20,
                  "model": {
                    "type": "minecraft:model",
                    "model": "oborokage:item/ancient_voidstring_charged8"
                  }
                },
                {
                  "threshold": 30,
                  "model": {
                    "type": "minecraft:model",
                    "model": "oborokage:item/ancient_voidstring_charged12"
                  }
                },
                {
                  "threshold": 40,
                  "model": {
                    "type": "minecraft:model",
                    "model": "oborokage:item/ancient_voidstring_charged15"
                  }
                }
              ],
              "fallback": {
                "type": "minecraft:model",
                "model": "oborokage:item/ancient_voidstring_sheathed"
              }
            }
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": "gui",
          "model": {
            "type": "minecraft:model",
            "model": "oborokage:item/voidstring_icon"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
