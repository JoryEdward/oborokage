{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "oborokage:item/icon"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": {
        "type": "minecraft:model",
        "model": "oborokage:item/tachi"
      },
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "scale": 1,
        "entries": [
          {
            "threshold": 10,
            "model": {
              "type": "minecraft:model",
              "model": "oborokage:item/charged4"
            }
          },
          {
            "threshold": 20,
            "model": {
              "type": "minecraft:model",
              "model": "oborokage:item/charged8"
            }
          },
          {
            "threshold": 30,
            "model": {
              "type": "minecraft:model",
              "model": "oborokage:item/charged12"
            }
          },
          {
            "threshold": 40,
            "model": {
              "type": "minecraft:model",
              "model": "oborokage:item/charged15"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "oborokage:item/sheathed"
        }
      }
    }
  }
}
