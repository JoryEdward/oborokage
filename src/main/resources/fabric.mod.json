{
  "schemaVersion": 1,
  "id": "oborokage",
  "version": "${version}",
  "name": "胧影剑录 · Oborokage",
  "description": "长刃居合、双刀连斩、精准架刀与双月奥义。",
  "authors": [
    "Jory Edward"
  ],
  "license": "MIT",
  "environment": "*",
  "icon": "assets/oborokage/icon.png",
  "entrypoints": {
    "main": [
      "oborokage.Oborokage"
    ],
    "client": [
      "oborokage.client.OborokageClient"
    ],
    "modmenu": [
      "oborokage.client.ModMenuEntry"
    ],
    "jei_mod_plugin": ["oborokage.compat.jei.OborokageJei"],
    "jade": ["oborokage.compat.jade.OborokageJade"]
  },
  "mixins": [
    {
      "config": "oborokage.client.mixins.json",
      "environment": "client"
    },
    "oborokage.mixins.json",
    {
      "config": "oborokage.compat.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "${loader_dependency}",
    "minecraft": "${mc_dependency}",
    "java": ">=25",
    "fabric-api": "${api_dependency}"
  }
}
